# Copia este ficheiro para .env.local e preenche os valores.
# Nunca faças commit de .env.local.

# URL público do site (usado em metadata, sitemap e User-Agent)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Email de contacto incluído no User-Agent enviado às APIs (IPMA, Fogos.pt)
CONTACT_EMAIL=teu-email@exemplo.pt

# Chave da API do Fogos.pt — pedida em https://api.fogos.pt/api/request-access
# Sem ela, a camada de incêndios fica desligada.
FOGOS_API_KEY=

# Upstash Redis (snapshots dos últimos dados bons).
# A integração Upstash no Vercel Marketplace cria KV_REST_API_URL / KV_REST_API_TOKEN;
# em alternativa podes usar os nomes UPSTASH_REDIS_REST_URL / UPSTASH_REDIS_REST_TOKEN.
# Sem Redis, a app usa uma cache em memória (suficiente para desenvolvimento).
KV_REST_API_URL=
KV_REST_API_TOKEN=
